  "keywords": [
    "documentation",
    "docs",
    "markdown",
    "documentation-template",
    "static-site-generator",
    "static-site",
    "github-pages",
    "seo",
    "multilingual",
    "zero-dependencies",
    "documentacion"
  ],
  "homepage": "https://jrcesara7-bit.github.io/folderdocs/",
  "bugs": "https://github.com/jrcesara7-bit/folderdocs/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jrcesara7-bit/folderdocs.git"
  },
  "license": "MIT",
  "author": "jrcesara7-bit",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "node tools/serve.mjs",
    "build": "node tools/build-site.mjs",
    "test": "node --test tests/*.test.mjs"
  }
}
